{
  "name": "@tiara-stack/native-tooling-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp run -r format",
    "format:apply": "vp run -r format:apply",
    "lint": "vp run -r lint",
    "test": "vp run -r test && pnpm check:patches",
    "build": "vp run -r build && pnpm check:tsc-build",
    "check:tsc-build": "tsc -b tsconfig.build.json --pretty false",
    "check:patches": "node scripts/check-patches.mjs",
    "native:build": "pnpm native:build:tsgolint && pnpm native:build:oxlint",
    "native:build:tsgolint": "cd native/tsgolint-effect-fork && GOCACHE=${GOCACHE:-/tmp/go-build-cache} GOTMPDIR=${GOTMPDIR:-/tmp} go build -o tsgolint ./cmd/tsgolint",
    "native:build:oxlint": "cd native/oxc-oxlint-effect-fork && PATH=\"$HOME/.cargo/bin:/opt/data/dev-home/.cargo/bin:$PATH\" cargo build -p oxlint --release --features allocator",
    "native:stage": "node scripts/stage-local-binaries.mjs",
    "native:smoke": "cd native/tsgolint-effect-fork && ./scripts/headless-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
