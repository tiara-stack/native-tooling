diff --git a/bin/oxlint b/bin/oxlint
index 874f626..a0bfb9b 100755
--- a/bin/oxlint
+++ b/bin/oxlint
@@ -1,3 +1,106 @@
 #!/usr/bin/env node
 
-import "../dist/cli.js";
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdtempSync, writeFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const nativeOxlintPath =
+  process.env.TIARA_REAL_OXLINT_PATH ??
+  process.env.TIARA_OXLINT_EFFECT_PATH ??
+  resolvePackageBin("@tiara-stack/oxlint-effect/bin/oxlint-effect") ??
+  join(process.cwd(), "native/oxc-oxlint-effect-fork/target/release/oxlint");
+
+if (existsSync(nativeOxlintPath)) {
+  const args = await prepareNativeArgs(process.argv.slice(2));
+  const result = spawnSync(nativeOxlintPath, args, { stdio: "inherit", env: process.env });
+  if (result.error) throw result.error;
+  process.exit(result.status ?? 1);
+}
+
+async function prepareNativeArgs(args) {
+  const existingConfig = getConfigArg(args);
+  if (existingConfig && !isTypeScriptConfig(existingConfig)) {
+    return args;
+  }
+
+  const viteConfigPath = existingConfig ?? findViteConfig(process.cwd());
+  if (!viteConfigPath || !isTypeScriptConfig(viteConfigPath)) {
+    return args;
+  }
+
+  const config = await importViteLintConfig(viteConfigPath);
+  if (!config) {
+    return args;
+  }
+
+  const dir = mkdtempSync(join(tmpdir(), "oxlint-native-config-"));
+  const configPath = join(dir, "oxlintrc.json");
+  writeFileSync(configPath, `${JSON.stringify(config)}\n`);
+  return replaceConfigArg(args, configPath);
+}
+
+function getConfigArg(args) {
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i];
+    if (arg === "-c" || arg === "--config") {
+      return args[i + 1] ? resolve(args[i + 1]) : undefined;
+    }
+    if (arg.startsWith("--config=")) {
+      return resolve(arg.slice("--config=".length));
+    }
+    if (arg.startsWith("-c=")) {
+      return resolve(arg.slice("-c=".length));
+    }
+  }
+}
+
+function replaceConfigArg(args, configPath) {
+  const next = [];
+  for (let i = 0; i < args.length; i++) {
+    const arg = args[i];
+    if (arg === "-c" || arg === "--config") {
+      next.push(arg, configPath);
+      i++;
+    } else if (arg.startsWith("--config=")) {
+      next.push(`--config=${configPath}`);
+    } else if (arg.startsWith("-c=")) {
+      next.push(`-c=${configPath}`);
+    } else {
+      next.push(arg);
+    }
+  }
+  return getConfigArg(next) ? next : ["--config", configPath, ...next];
+}
+
+function findViteConfig(start) {
+  let dir = resolve(start);
+  while (true) {
+    const file = join(dir, "vite.config.ts");
+    if (existsSync(file)) return file;
+    const parent = dirname(dir);
+    if (parent === dir) return undefined;
+    dir = parent;
+  }
+}
+
+function isTypeScriptConfig(path) {
+  return path.endsWith(".ts") || path.endsWith(".mts") || path.endsWith(".cts");
+}
+
+async function importViteLintConfig(path) {
+  const mod = await import(`${pathToFileURL(path).href}?native-oxlint=${Date.now()}`);
+  return mod.default?.lint ?? undefined;
+}
+
+function resolvePackageBin(specifier) {
+  try {
+    return createRequire(import.meta.url).resolve(specifier, { paths: [process.cwd()] });
+  } catch {
+    return undefined;
+  }
+}
+
+await import("../dist/cli.js");
