diff --git a/dist/test-delegate.js b/dist/test-delegate.js
new file mode 100644
index 0000000..119dc84
--- /dev/null
+++ b/dist/test-delegate.js
@@ -0,0 +1,37 @@
+import { spawnSync } from 'node:child_process';
+import { existsSync, realpathSync } from 'node:fs';
+import { delimiter, dirname, join, sep } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const localVp = join(process.cwd(), 'node_modules', '.bin', process.platform === 'win32' ? 'vp.cmd' : 'vp');
+const localVitePlus = join(process.cwd(), 'node_modules', 'vite-plus');
+
+function localNodePath() {
+    const vitePlusRoot = realpathSync(localVitePlus);
+    const storeNodeModules = dirname(vitePlusRoot);
+    const pnpmMarker = `${sep}node_modules${sep}.pnpm${sep}`;
+    const markerIndex = vitePlusRoot.indexOf(pnpmMarker);
+    const pnpmNodeModules = markerIndex === -1 ? undefined : join(vitePlusRoot.slice(0, markerIndex), 'node_modules', '.pnpm', 'node_modules');
+    return [join(vitePlusRoot, 'node_modules'), storeNodeModules, pnpmNodeModules].filter(Boolean).join(delimiter);
+}
+
+if (process.env.VP_TEST_DELEGATED !== '1' && existsSync(localVp) && existsSync(localVitePlus)) {
+    const env = {
+        ...process.env,
+        NODE_PATH: localNodePath(),
+        VP_TEST_DELEGATED: '1',
+    };
+    delete env.VP_VITEST_CLI_PATH;
+
+    const result = spawnSync(localVp, ['test', ...process.argv.slice(2)], {
+        stdio: 'inherit',
+        env,
+    });
+    process.exit(result.status ?? 1);
+}
+
+if (!process.env.VP_VITEST_CLI_PATH) {
+    throw new Error('Missing VP_VITEST_CLI_PATH for Vite+ test runner');
+}
+
+await import(pathToFileURL(process.env.VP_VITEST_CLI_PATH).href);
