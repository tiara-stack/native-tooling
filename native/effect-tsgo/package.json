{
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "setup-repo": "node ../../scripts/generate-native.mjs",
    "check": "pnpm run check:go && pnpm --filter @effect/tsgo check && pnpm run check:repoctl",
    "check:repoctl": "pnpm --filter @effect/tsgo-repoctl check",
    "changeset": "changeset",
    "lint": "CGO_ENABLED=0 golangci-lint run ./...",
    "test": "pnpm run test:go && pnpm --filter @effect/tsgo test && pnpm run test:repoctl",
    "test:repoctl": "pnpm --filter @effect/tsgo-repoctl test",
    "build": "pnpm run build:go && pnpm --filter @effect/tsgo build",
    "check:go": "CGO_ENABLED=0 go build ./...",
    "test:go": "CGO_ENABLED=0 go test ./...",
    "build:go": "CGO_ENABLED=0 go -C ../typescript-go build -o built/local/tsgo ./cmd/tsgo"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0-next.10",
    "@effect/tsgo-repoctl": "workspace:*"
  }
}
