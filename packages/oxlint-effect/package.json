{
  "name": "@tiara-stack/oxlint-effect",
  "version": "0.1.1",
  "description": "Oxlint binary wrapper for Tiara Stack native Effect diagnostics tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiara-stack/native-tooling.git",
    "directory": "packages/oxlint-effect"
  },
  "bin": {
    "oxlint-effect": "bin/oxlint-effect.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bin/oxlint-effect": "./bin/oxlint-effect.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt --check",
    "format:apply": "vp fmt",
    "lint": "vp lint src bin",
    "test": "echo 'no tests defined'"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@tiara-stack/oxlint-effect-linux-x64": "workspace:0.1.0"
  }
}
