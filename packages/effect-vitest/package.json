{
  "name": "@tiara-stack/effect-vitest",
  "version": "4.0.1",
  "description": "Tiara Stack fork of @effect/vitest wired to Vite+ test exports.",
  "bugs": {
    "url": "https://github.com/tiara-stack/native-tooling/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiara-stack/native-tooling.git",
    "directory": "packages/effect-vitest"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt --check",
    "format:apply": "vp fmt",
    "lint": "vp lint src",
    "test": "vp test --run --maxWorkers=2 && node --test ../../scripts/test/sync-effect-vitest.test.mjs"
  },
  "devDependencies": {
    "@tiara-stack/vite-plus": "link:../vite-plus-effect-fork/packages/cli",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tiara-stack/vite-plus": ">=1.0.0 <2.0.0",
    "effect": "^4.0.1",
    "vitest": ">=5.0.0 <6.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
